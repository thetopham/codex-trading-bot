# Safety: PAPER is the default. Do not point this at live Alpaca without explicit approval.
TRADING_MODE=paper
DRY_RUN=true

# Alpaca paper endpoints
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Optional Perplexity research. If unset, research workflow writes a fallback TODO section.
PERPLEXITY_API_KEY=your_perplexity_key_here
PERPLEXITY_MODEL=sonar

# Telegram notifications. If unset, scripts/telegram.sh appends to DAILY-SUMMARY.md.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Risk defaults
MAX_OPEN_POSITIONS=6
MAX_NEW_TRADES_PER_WEEK=3
MAX_POSITION_EQUITY_PCT=0.20
MAX_DAYTRADE_COUNT_UNDER_25K=3
DEFAULT_TRAIL_PERCENT=10
LOSS_CUT_PCT=-0.07
